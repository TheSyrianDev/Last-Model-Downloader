# Maintainer: Omar Baroud
pkgname=model-downloader
pkgver=0.2.0
pkgrel=1
pkgdesc="Model downloader for the Hugging Face Hub, ModelScope and Pirate Face"
arch=('x86_64')
url="https://github.com/TheSyrianDev/Model-Downloader"
license=('Apache-2.0' 'LicenseRef-PolyForm-Noncommercial-1.0.0')
depends=('gcc-libs')
makedepends=('cargo')
options=('!lto')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

prepare() {
  cd "Model-Downloader-$pkgver"
  cargo fetch --locked --target "$CARCH-unknown-linux-gnu"
}

build() {
  cd "Model-Downloader-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release -p hfd-cli
}

check() {
  cd "Model-Downloader-$pkgver"
  cargo test --frozen --release -p hfd-core
}

package() {
  cd "Model-Downloader-$pkgver"
  install -Dm755 target/release/mdl "$pkgdir/usr/bin/mdl"
  ln -s mdl "$pkgdir/usr/bin/model-downloader"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 crates/hfd-core/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-hfd-core"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
